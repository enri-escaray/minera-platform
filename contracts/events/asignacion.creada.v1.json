{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "asignacion.creada.v1",
  "type": "object",
  "required": ["event_id", "event_type", "version", "sitio_id", "occurred_at", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "asignacion.creada"},
    "version": {"const": 1},
    "sitio_id": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string"},
    "data": {
      "type": "object",
      "required": ["asignacion_id", "camion_id", "pala_id", "espera_estimada_min", "motivo"],
      "properties": {
        "asignacion_id": {"type": "string", "format": "uuid"},
        "camion_id": {"type": "string"},
        "pala_id": {"type": "string"},
        "espera_estimada_min": {"type": "number", "minimum": 0},
        "motivo": {"type": "string"}
      }
    }
  }
}
