{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lote.creado.v1",
  "type": "object",
  "required": ["event_id", "event_type", "version", "sitio_id", "occurred_at", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "lote.creado"},
    "version": {"const": 1},
    "sitio_id": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string"},
    "data": {
      "type": "object",
      "required": ["lote_id", "codigo", "tipo"],
      "properties": {
        "lote_id": {"type": "string", "format": "uuid"},
        "codigo": {"type": "string"},
        "disparo_id": {"type": ["string", "null"]},
        "tipo": {"enum": ["rom", "stock", "alimentacion_planta", "concentrado", "relave"]},
        "lotes_origen": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
