{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "novedad.registrada.v1",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "version",
    "sitio_id",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "novedad.registrada"
    },
    "version": {
      "const": 1
    },
    "sitio_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "novedad_id",
        "turno",
        "fecha",
        "categoria",
        "texto",
        "autor"
      ],
      "properties": {
        "novedad_id": {
          "type": "string"
        },
        "turno": {
          "type": "string"
        },
        "fecha": {
          "type": "string"
        },
        "categoria": {
          "type": "string"
        },
        "texto": {
          "type": "string"
        },
        "autor": {
          "type": "string"
        }
      }
    }
  }
}