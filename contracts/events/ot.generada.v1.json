{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ot.generada.v1",
  "type": "object",
  "required": ["event_id", "event_type", "version", "sitio_id", "occurred_at", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "ot.generada"},
    "version": {"const": 1},
    "sitio_id": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string"},
    "data": {
      "type": "object",
      "required": ["ot_id", "equipo_id", "origen", "prioridad"],
      "properties": {
        "ot_id": {"type": "string", "format": "uuid"},
        "equipo_id": {"type": "string"},
        "origen": {"enum": ["predictivo", "preventivo", "correctivo", "inspeccion"]},
        "prioridad": {"enum": ["critica", "alta", "media", "baja"]},
        "diagnostico": {"type": "string"},
        "repuestos_sugeridos": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
